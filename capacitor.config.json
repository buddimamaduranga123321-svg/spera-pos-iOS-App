{
	"appId": "com.spitsolutions.sperapos",
	"appName": "Spera POS",
	"webDir": "dist",
	"bundledWebRuntime": false,
	"android": {
		"allowMixedContent": false,
		"captureInput": true,
		"initialFocus": false
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1200,
			"backgroundColor": "#1D4ED8",
			"showSpinner": false
		}
	},
	"packageClassList": [
		"LocalNotificationsPlugin"
	]
}
